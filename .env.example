# Edital Enrichment Pipeline

# Chave da API Mistral — usada para OCR de PDFs e extração/resumo estruturado
# dos editais (FAPES, CONIF, CAPES, CNPq, PRPPG/IFES, PROEX/IFES) e para
# classificar a categoria das chamadas FINEP.
# Obrigatória: MistralExtractionService levanta erro se não estiver definida.
MISTRAL_API_KEY=sua_chave_mistral_aqui

# Chave da OpenAI — provedor de RESERVA. Assume a extração quando a Mistral
# recusa a credencial ou a assinatura (HTTP 401/402/403), para que uma conta sem
# crédito não pare a coleta inteira.
# Opcional: sem ela o pipeline roda só na Mistral, como antes.
#
# ATENÇÃO — a reserva não faz OCR. A Mistral lê PDF digitalizado com
# `mistral-ocr-latest`; a OpenAI aqui recebe o texto extraído localmente por
# pdfplumber, que só lê a camada de texto do PDF. Edital nativo digital (a
# maioria) sai igual; PDF que é imagem escaneada é recusado explicitamente em
# vez de virar um edital inventado.
# API_KEY=sua_chave_openai_aqui

# Modelo da OpenAI usado pela reserva. Padrão: gpt-4o.
# OPENAI_MODEL=gpt-4o

# Ano de referência para filtro de editais (ex.: FINEP).
# Só entram chamadas cujo prazo de envio de propostas termina neste ano ou depois.
# Se não definido, usa o ano atual.
# REFERENCE_YEAR=2026
